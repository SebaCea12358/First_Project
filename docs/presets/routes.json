  "rules": [
    {
      "id": "growth.global",
      "description": "Una sola subida de edad entre todas tus llamas por turno. Seguir alimentando es legal.",
      "status": "confirmed",
      "source": "§4.1"
    },
    {
      "id": "growth.activation",
      "description": "Bebé → joven especializada → adulta. Recursos almacenados no crecen solos y gastarlos no rejuvenece.",
      "status": "confirmed",
      "source": "§4.1"
    },
    {
      "id": "victory.simultaneous",
      "description": "La victoria exige adultas simultáneas, nunca un total histórico.",
      "status": "confirmed",
      "source": "§4.3"
    },
    {
      "id": "explosion.owner",
      "description": "Solo la explosiva elegida por el dueño de la explosión puede crecer.",
      "status": "confirmed",
      "source": "§4.2"
    },
    {
      "id": "evil.activation",
      "description": "Solo robar una bebé o un recurso con éxito activa malvada; robar cartas no.",
      "status": "confirmed",
      "source": "§4.2"
    },
    {
      "id": "baby.compatibility",
      "description": "Una bebé solo recibe una especialización cuando tiene permiso para crecer.",
      "status": "provisional",
      "source": "§5"
    },
    {
      "id": "turn.order",
      "description": "Incorporación opcional → robo → acciones libres → fin voluntario. Una bebé gratis por turno.",
      "status": "provisional",
      "source": "§5"
    },
    {
      "id": "cost.herd",
      "description": "Paga desde cualquier llama propia, eligiendo las fuentes. Recursos no negativos.",
      "status": "provisional",
      "source": "§5"
    },
    {
      "id": "victory.atomic",
      "description": "Se comprueba victoria tras cada efecto atómico y su ventana preventiva.",
      "status": "provisional",
      "source": "§5"
    },
    {
      "id": "research.persistence",
      "description": "Granja y Valla son únicas; por defecto persisten al perder estudiosa.",
      "status": "provisional",
      "source": "§6.1"
    },
    {
      "id": "chaos.table",
      "description": "Tabla de seis resultados con pesos editables; regalos no alimentan. Robo de loca sin Alarma por defecto.",
      "status": "experimental",
      "source": "§6.3"
    },
    {
      "id": "holy.route",
      "description": "Santa no cuenta para ganar ni coexiste con malvada. Bendición se suspende sin santa adulta.",
      "status": "experimental",
      "source": "§7.1"
    },
    {
      "id": "powers.routes",
      "description": "Poderosas: dos copias, una activación por jugador; cartas usadas fuera del circuito.",
      "status": "experimental",
      "source": "§7"
    },
    {
      "id": "laboratory.variants",
      "description": "Mercado, anuncio con vuelta de espera, explosión extra y reciclaje diferido son opciones separadas.",
      "status": "experimental",
      "source": "§8"
    }
  ],
